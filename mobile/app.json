{
  "expo": {
    "name": "TJ Marketplace",
    "slug": "marketplace-tj",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "marketplace-tj",
    "splash": {
      "backgroundColor": "#4F46E5"
    },
